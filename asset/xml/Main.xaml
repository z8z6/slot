<?xml version="1.0" encoding="utf-8"?>
<!-- Demo 编辑器界面。保存文件后，主线程会在下一帧完成事务式热重载。 -->
<UI Direction="Column">
  <ToolBar Id="toolbar" Dock="Top" DockExtent="36">
    <Menu Id="file-menu" Text="File">
      <MenuItem Id="new-level" Text="New Level" />
      <Menu Id="open-menu" Text="Open">
        <MenuItem Id="open-project" Text="Project" />
        <Menu Id="recent-menu" Text="Recent">
          <MenuItem Id="recent-demo" Text="Demo.slot" />
          <MenuItem Id="recent-empty" Text="Empty.slot" />
        </Menu>
      </Menu>
      <MenuItem Id="save-level" Text="Save" />
    </Menu>
    <Menu Id="edit-menu" Text="Edit">
      <MenuItem Id="undo" Text="Undo" />
      <MenuItem Id="redo" Text="Redo" />
    </Menu>
    <Menu Id="build-menu" Text="Build">
      <MenuItem Id="build-all" Text="Build All" />
      <MenuItem Id="build-lighting" Text="Build Lighting" />
    </Menu>
  </ToolBar>

  <Terminal Id="terminal" Title="Output Log" Dock="Bottom"
            DockExtent="180" />

  <PanelGroup Id="left-browser" Dock="Left" DockExtent="280">
    <Panel Id="content-browser" Title="Content Browser">
      <FileExplorer Id="file-explorer" RootPath="asset" FlexGrow="1" />
    </Panel>
    <Panel Id="world-outliner" Title="World Outliner">
      <!-- 场景对象由 DemoApplication 在装载后写入，TreeView 不拥有业务对象。 -->
      <TreeView Id="scene-hierarchy" FlexGrow="1" />
    </Panel>
  </PanelGroup>

  <Panel Id="details" Title="Details" Dock="Right" DockExtent="320">
    <!-- Type 是运行时类信息；其余对象数据均由 TextInput 双向绑定。 -->
    <Text Id="details-type" Text="No object selected" />
    <Text Text="Object" />
    <UI Direction="Row" Height="30">
      <Text Text="Name" Width="92" />
      <TextInput Id="details-name" Placeholder="-" FlexGrow="1" Margin="2" />
    </UI>
    <Text Text="Resources" />
    <UI Direction="Row" Height="30">
      <Text Text="Mesh" Width="92" />
      <TextInput Id="details-mesh" Placeholder="-" FlexGrow="1" Margin="2" />
    </UI>
    <UI Direction="Row" Height="30">
      <Text Text="Material" Width="92" />
      <TextInput Id="details-material" Placeholder="-" FlexGrow="1" Margin="2" />
    </UI>
    <Text Text="Transform" />
    <UI Direction="Row" Height="30">
      <Text Text="Position X" Width="92" />
      <TextInput Id="details-position-x" Placeholder="0" FlexGrow="1" Margin="2" />
    </UI>
    <UI Direction="Row" Height="30">
      <Text Text="Position Y" Width="92" />
      <TextInput Id="details-position-y" Placeholder="0" FlexGrow="1" Margin="2" />
    </UI>
    <UI Direction="Row" Height="30">
      <Text Text="Position Z" Width="92" />
      <TextInput Id="details-position-z" Placeholder="0" FlexGrow="1" Margin="2" />
    </UI>
    <UI Direction="Row" Height="30">
      <Text Text="Rotation X" Width="92" />
      <TextInput Id="details-rotation-x" Placeholder="0" FlexGrow="1" Margin="2" />
    </UI>
    <UI Direction="Row" Height="30">
      <Text Text="Rotation Y" Width="92" />
      <TextInput Id="details-rotation-y" Placeholder="0" FlexGrow="1" Margin="2" />
    </UI>
    <UI Direction="Row" Height="30">
      <Text Text="Rotation Z" Width="92" />
      <TextInput Id="details-rotation-z" Placeholder="0" FlexGrow="1" Margin="2" />
    </UI>
    <UI Direction="Row" Height="30">
      <Text Text="Scale X" Width="92" />
      <TextInput Id="details-scale-x" Placeholder="1" FlexGrow="1" Margin="2" />
    </UI>
    <UI Direction="Row" Height="30">
      <Text Text="Scale Y" Width="92" />
      <TextInput Id="details-scale-y" Placeholder="1" FlexGrow="1" Margin="2" />
    </UI>
    <UI Direction="Row" Height="30">
      <Text Text="Scale Z" Width="92" />
      <TextInput Id="details-scale-z" Placeholder="1" FlexGrow="1" Margin="2" />
    </UI>
  </Panel>
  <Scene Id="scene-viewport" Title="Perspective" Dock="Fill" />
</UI>
